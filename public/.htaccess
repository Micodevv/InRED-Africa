# Fallback SPA : toute URL inconnue (/about, /news?article=x…) sert index.html.
# Requis pour la navigation par vraies URLs. Les fichiers réels (assets,
# sitemap.xml, google52409f882b50cffb.html) sont servis directement.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Ne pas réécrire les fichiers et dossiers réellement présents
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Un asset manquant doit renvoyer 404, jamais index.html (sinon le
  # navigateur reçoit du HTML à la place du JS/CSS et garde l'ancien cache).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/ - [L]

  RewriteRule . /index.html [L]
</IfModule>

# Cache long pour les assets nominés par hash, court pour index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
